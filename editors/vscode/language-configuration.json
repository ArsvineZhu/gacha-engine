{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string"] }
  ],
  "surroundingPairs": [
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^.*:\\s*(#.*)?$"
  },
  "onEnterRules": [
    {
      "beforeText": "^.*:\\s*(#.*)?$",
      "action": { "indent": "indent" }
    }
  ],
  "wordPattern": "(@[a-z]+|[A-Za-z_][A-Za-z0-9_]*|\\d+(?:/\\d+)?[pwctr])"
}
