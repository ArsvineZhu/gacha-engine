      "id": "assumption.soft_pity.remainder_proportional",
      "status": "inferred",
      "description": "When 6-star probability rises, 5-star and 4-star split the remaining mass in their base 80:912 ratio."
    },
    {
      "id": "assumption.five_plus.conditional",
      "status": "inferred",
      "description": "When the 5-star+ guarantee triggers, the current distribution is conditioned on rarity >= 5."
    }
