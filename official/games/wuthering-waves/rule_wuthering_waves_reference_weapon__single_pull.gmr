# 源规则 wuthering-waves.reference.weapon 动作 single_pull
rule rule_wuthering_waves_reference_weapon__single_pull:
    featured_due: Bool @pity = false
    four_pity: Counter[9c] @pity = 0c
    pity: Counter[79c] @pity = 0c
    pool_four: Pool[4r]
    pool_three: Pool[3r]
    pool_featured: Pool[5r]
    pool_standard: Pool[5r]
    sel_four: Selector[4r] = from pool_four
    sel_three: Selector[3r] = from pool_three
    sel_top: Selector[5r] = from pool_featured
    dist_rarity_name: Distribution:
        5r: 1/125p -> sel_top
        4r: 60w -> sel_four
        3r: 932w -> sel_three
    single_pull: Action[1t..1000t] = dist_rarity_name
    guarantee hard_pity: pity >= 79c -> rarity 5r
    guarantee four_floor: four_pity >= 9c -> floor 4r promote
    update result.grade == 5r:
        reset pity
    update not (result.grade == 5r):
        pity += 1c
    update result.grade >= 4r:
        reset four_pity
    update not (result.grade >= 4r):
        four_pity += 1c
    update result in pool_standard:
        featured_due = true
    update result in pool_featured:
        featured_due = false
