{
  "schema_version": 1,
  "id": "endfield.reference.chartered.fixed-five",
  "version": "0.1.0",
  "description": "机制与符号槽位定义；具体可抽范围和身份由卡池清单组装。",
  "assumptions": [
    {
      "id": "assumption.soft_pity.fixed_five",
      "status": "inferred",
      "description": "六星概率增长时，五星保持 8%，四星取得剩余质量。"
    },
    {
      "id": "assumption.five_plus.preserve_six",
      "status": "inferred",
      "description": "五星以上保底触发时，保留六星概率，将低稀有度质量移至五星。"
    },
    {
      "id": "free.floor",
      "status": "inferred",
      "description": "免费批次最后一抽且此前无五星以上时，将低稀有度质量移至五星；接入应用负责票券检查。"
    }
  ],
  "state": [
    {
      "id": "six_star_pity",
      "kind": "counter",
      "scope": "pity_group",
      "initial": 0,
      "max": 79,
      "description": "连续未出现六星的计数抽数。"
    },
    {
      "id": "five_plus_pity",
      "kind": "counter",
      "scope": "pity_group",
      "initial": 0,
      "max": 9,
      "description": "连续未出现五星或六星的计数抽数。"
    },
    {
      "id": "banner_pulls",
      "kind": "counter",
      "scope": "progress_group",
      "initial": 0,
      "description": "当期卡池或同名系列的累计进度抽数。"
    },
    {
      "id": "featured_guarantee_available",
      "kind": "boolean",
      "scope": "progress_group",
      "initial": true,
      "description": "一次性 120 抽目标保底是否仍可使用。"
    },
    {
      "id": "free_batch_draws",
      "kind": "counter",
      "scope": "batch",
      "initial": 0,
      "max": 10
    },
    {
      "id": "free_batch_five_seen",
      "kind": "boolean",
      "scope": "batch",
      "initial": false
    }
  ],
  "distributions": [
    {
      "id": "chartered_rarity",
      "evidence": [
        "endfield.official.base_rates"
      ],
      "assumptions": [
        "assumption.soft_pity.fixed_five"
      ],
      "entries": [
        {
          "rarity": 6,
          "type": "linear_after",
          "state": "six_star_pity",
          "base": "0.008",
          "after": 65,
          "increment": "0.05",
          "cap": "1"
        },
        {
          "rarity": 5,
          "type": "constant",
          "value": "0.08"
        },
        {
          "rarity": 4,
          "type": "remainder"
        }
      ]
    },
    {
      "id": "free_rarity",
      "entries": [
        {
          "rarity": 6,
          "type": "constant",
          "value": "0.008"
        },
        {
          "rarity": 5,
          "type": "constant",
          "value": "0.08"
        },
        {
          "rarity": 4,
          "type": "remainder"
        }
      ]
    }
  ],
  "selectors": [
    {
      "id": "selector.current_featured",
      "type": "pool",
      "pool": "pool.current_featured"
    },
    {
      "id": "selector.six_off_banner",
      "type": "pool",
      "pool": "pool.six_off_banner"
    },
    {
      "id": "selector.six",
      "type": "weighted",
      "branches": [
        {
          "weight": "1",
          "selector": "selector.current_featured"
        },
        {
          "weight": "1",
          "selector": "selector.six_off_banner"
        }
      ]
    },
    {
      "id": "selector.five",
      "type": "pool",
      "pool": "pool.five"
    },
    {
      "id": "selector.four",
      "type": "pool",
      "pool": "pool.four"
    }
  ],
  "banners": [
    {
      "id": "endfield.banner.reference",
      "pity_group": "endfield.chartered",
      "progress_group": "endfield.banner.reference",
      "actions": [
        {
          "id": "single_pull",
          "distribution": "chartered_rarity",
          "selectors": {
            "6": "selector.six",
            "5": "selector.five",
            "4": "selector.four"
          },
          "guarantees": [
            {
              "id": "featured_120",
              "priority": 300,
              "when": {
                "op": "all",
                "conditions": [
                  {
                    "op": "state_counter_gte",
                    "state": "banner_pulls",
                    "value": 119
                  },
                  {
                    "op": "state_bool_eq",
                    "state": "featured_guarantee_available",
                    "value": true
                  }
                ]
              },
              "effect": {
                "type": "force_item",
                "item": "featured"
              },
              "evidence": [
                "endfield.official.base_rates"
              ]
            },
            {
              "id": "six_star_80",
              "priority": 200,
              "when": {
                "op": "state_counter_gte",
                "state": "six_star_pity",
                "value": 79
              },
              "effect": {
                "type": "force_rarity",
                "rarity": 6
              },
              "evidence": [
                "endfield.official.base_rates"
              ]
            },
            {
              "id": "five_plus_10",
              "priority": 100,
              "when": {
                "op": "state_counter_gte",
                "state": "five_plus_pity",
                "value": 9
              },
              "effect": {
                "type": "min_rarity",
                "rarity": 5,
                "strategy": "preserve_higher_fill_floor"
              },
              "evidence": [
                "endfield.official.base_rates"
              ],
              "assumptions": [
                "assumption.five_plus.preserve_six"
              ]
            }
          ],
          "transitions": [
            {
              "id": "six_star_reset",
              "when": {
                "op": "outcome_rarity_eq",
                "rarity": 6
              },
              "updates": [
                {
                  "type": "reset",
                  "state": "six_star_pity"
                }
              ]
            },
            {
              "id": "six_star_increment",
              "when": {
                "op": "not",
                "condition": {
                  "op": "outcome_rarity_eq",
                  "rarity": 6
                }
              },
              "updates": [
                {
                  "type": "increment",
                  "state": "six_star_pity"
                }
              ]
            },
            {
              "id": "five_plus_reset",
              "when": {
                "op": "outcome_rarity_gte",
                "rarity": 5
              },
              "updates": [
                {
                  "type": "reset",
                  "state": "five_plus_pity"
                }
              ]
            },
            {
              "id": "five_plus_increment",
              "when": {
                "op": "not",
                "condition": {
                  "op": "outcome_rarity_gte",
                  "rarity": 5
                }
              },
              "updates": [
                {
                  "type": "increment",
                  "state": "five_plus_pity"
                }
              ]
            },
            {
              "id": "banner_progress",
              "when": {
                "op": "always"
              },
              "updates": [
                {
                  "type": "increment",
                  "state": "banner_pulls"
                }
              ]
            },
            {
              "id": "consume_featured_guarantee",
              "when": {
                "op": "outcome_item_in_pool",
                "pool": "pool.current_featured"
              },
              "updates": [
                {
                  "type": "set_bool",
                  "state": "featured_guarantee_available",
                  "value": false
                }
              ]
            },
            {
              "id": "quota_6",
              "when": {
                "op": "outcome_rarity_eq",
                "rarity": 6
              },
              "events": [
                {
                  "kind": "grant_currency",
                  "key": "arsenal_quota",
                  "amount": 2000
                }
              ]
            },
            {
              "id": "quota_5",
              "when": {
                "op": "outcome_rarity_eq",
                "rarity": 5
              },
              "events": [
                {
                  "kind": "grant_currency",
                  "key": "arsenal_quota",
                  "amount": 200
                }
              ]
            },
            {
              "id": "quota_4",
              "when": {
                "op": "outcome_rarity_eq",
                "rarity": 4
              },
              "events": [
                {
                  "kind": "grant_currency",
                  "key": "arsenal_quota",
                  "amount": 20
                }
              ]
            },
            {
              "id": "reward_30",
              "when": {
                "op": "state_counter_eq",
                "state": "banner_pulls",
                "value": 29
              },
              "events": [
                {
                  "kind": "grant_item",
                  "key": "urgent_recruitment_10",
                  "amount": 1
                }
              ]
            },
            {
              "id": "reward_60",
              "when": {
                "op": "state_counter_eq",
                "state": "banner_pulls",
                "value": 59
              },
              "events": [
                {
                  "kind": "grant_item",
                  "key": "next_banner_ticket_10",
                  "amount": 1
                }
              ]
            },
            {
              "id": "reward_240",
              "when": {
                "op": "state_modulo_eq",
                "state": "banner_pulls",
                "modulus": 240,
                "value": 239
              },
              "events": [
                {
                  "kind": "grant_item",
                  "key": "current_featured_token",
                  "amount": 1
                }
              ]
            }
          ]
        },
        {
          "id": "free_ten_pull",
          "draws": 10,
          "distribution": "free_rarity",
          "selectors": {
            "6": "selector.six",
            "5": "selector.five",
            "4": "selector.four"
          },
          "guarantees": [
            {
              "id": "free_five_floor",
              "when": {
                "op": "all",
                "conditions": [
                  {
                    "op": "state_counter_eq",
                    "state": "free_batch_draws",
                    "value": 9
                  },
                  {
                    "op": "state_bool_eq",
                    "state": "free_batch_five_seen",
                    "value": false
                  }
                ]
              },
              "effect": {
                "type": "min_rarity",
                "rarity": 5,
                "strategy": "preserve_higher_fill_floor"
              },
              "priority": 100
            }
          ],
          "transitions": [
            {
              "id": "free_progress",
              "when": {
                "op": "always"
              },
              "updates": [
                {
                  "type": "increment",
                  "state": "free_batch_draws"
                }
              ],
              "events": []
            },
            {
              "id": "free_five_seen",
              "when": {
                "op": "outcome_rarity_gte",
                "rarity": 5
              },
              "updates": [
                {
                  "type": "set_bool",
                  "state": "free_batch_five_seen",
                  "value": true
                }
              ],
              "events": []
            }
          ]
        }
      ]
    }
  ],
  "source_documents": [
    "sources.json"
  ]
}
